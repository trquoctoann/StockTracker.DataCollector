# ============================================================
# StockTracker.DataCollector – Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the real values.
# All variables are optional and have sensible defaults unless marked REQUIRED.

# ────────────────────────────────────────────────────────────
# Application
# ────────────────────────────────────────────────────────────
APP_NAME=StockTracker.DataCollector
LOG_JSON=false                          # true → JSON logs (for production), false → console (dev)

# ────────────────────────────────────────────────────────────
# StockTracker API (target service)
# ────────────────────────────────────────────────────────────
STOCKTRACKER_API_BASE_URL=http://localhost:5000
API_PATH_INDUSTRIES_ALL=/api/industries/all
API_PATH_STOCKS_ALL=/api/stocks/all
API_PATH_INDUSTRIES_INGEST=/api/industries/sync
API_PATH_STOCKS_INGEST=/api/stocks/sync
API_PATH_MARKET_INDICES_INGEST=/api/market-indices/sync

# ────────────────────────────────────────────────────────────
# Keycloak (M2M Authentication)
# ────────────────────────────────────────────────────────────
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=stocktracker
KEYCLOAK_CLIENT_ID=data-collector-service
KEYCLOAK_CLIENT_SECRET=                 # REQUIRED for M2M auth

KEYCLOAK_TOKEN_SKEW_SECONDS=30.0        # Re-fetch token this many seconds before expiry

# ────────────────────────────────────────────────────────────
# HTTP
# ────────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=60.0

# ────────────────────────────────────────────────────────────
# RabbitMQ (required for market data pipeline)
# ────────────────────────────────────────────────────────────
RABBITMQ_ENABLED=false                  # Set to true to enable market data publishing
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=stocktracker
RABBITMQ_EXCHANGE_TYPE=topic            # topic | direct | fanout | headers
RABBITMQ_ROUTING_KEY_PRICE_HISTORY=stock_price_history.sync
RABBITMQ_ROUTING_KEY_INTRADAY=stock_intraday.sync

# ────────────────────────────────────────────────────────────
# Rate Limiting (Token Bucket per source)
# ────────────────────────────────────────────────────────────
RATE_LIMIT_VNSTOCK_PER_SECOND=0.25
RATE_LIMIT_VNSTOCK_BURST=1
RATE_LIMIT_HTTP_PER_SECOND=10.0
RATE_LIMIT_HTTP_BURST=20
RATE_LIMIT_RABBITMQ_PER_SECOND=50.0
RATE_LIMIT_RABBITMQ_BURST=100

# ────────────────────────────────────────────────────────────
# Scheduler (APScheduler cron jobs)
# ────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false                 # Set to true to enable automatic scheduled runs
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# Listing pipeline cron (industries + stocks + indices) – default: 06:00
SCHEDULER_CRON_HOUR=6
SCHEDULER_CRON_MINUTE=0

# Company pipeline cron (profiles + shareholders + officers + ...) – default: 07:00
SCHEDULER_COMPANY_CRON_HOUR=7
SCHEDULER_COMPANY_CRON_MINUTE=0

# Market data pipeline cron (price history + intraday) – default: 18:00
SCHEDULER_MARKET_DATA_CRON_HOUR=18
SCHEDULER_MARKET_DATA_CRON_MINUTE=0

# ────────────────────────────────────────────────────────────
# Market Data Settings
# ────────────────────────────────────────────────────────────
MARKET_DATA_CHUNK_SIZE=500              # Records per RabbitMQ message
VNSTOCK_PRICE_HISTORY_INTERVAL=1D      # Interval: 1m, 5m, 15m, 30m, 1h, 1D, 1W, 1M
VNSTOCK_HISTORY_LOOKBACK_DAYS=30
# VNSTOCK_HISTORY_START=2026-01-01     # Optional explicit backfill range
# VNSTOCK_HISTORY_END=2026-08-26
VNSTOCK_INTRADAY_PAGE_SIZE=100
VNSTOCK_INTRADAY_MAX_PAGES=1           # Bounded recent window, NOT the full trading day
VNSTOCK_LISTING_SOURCE=KBS
VNSTOCK_INDICES_SOURCE=KBS
VNSTOCK_COMPANY_SOURCE=KBS
VNSTOCK_QUOTE_SOURCE=KBS

# ────────────────────────────────────────────────────────────
# vnstock Index Groups
# ────────────────────────────────────────────────────────────
# VNSTOCK_INDEX_GROUP_NAMES=["HOSE Indices","Sector Indices","Investment Indices","VNX Indices"]
# VNSTOCK_EXTRA_INDEX_SYMBOLS=["HNX30"]
